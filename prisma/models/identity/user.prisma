model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  apiKeys        ApiKey[]
  sourceAccounts SourceAccount[]
  profile        StudentProfile?
  transcript     Transcript?
  planItems      PlanItem[]
  enrollments    Enrollment[]

  @@map("users")
}
